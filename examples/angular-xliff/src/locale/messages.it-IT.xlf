<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" version="2.0" srcLang="en-US" trgLang="it-IT">
  <file id="f1">
    <unit id="cartTitle" name="cartTitle">
      <segment>
        <source>Your cart</source>
        <target>Il tuo carrello</target>
      </segment>
    </unit>
    <unit id="checkout" name="checkout">
      <segment>
        <source>Checkout</source>
        <target>Vai al pagamento (smoke 2)</target>
      </segment>
    </unit>
    <unit id="continueShopping" name="continueShopping">
      <segment>
        <source>Continue shopping</source>
        <target>Continua lo shopping</target>
      </segment>
    </unit>
    <unit id="emptyCta" name="emptyCta">
      <segment>
        <source>Start shopping</source>
        <target>Inizia a fare acquisti</target>
      </segment>
    </unit>
    <unit id="greeting" name="greeting">
      <segment>
        <source>Hello, <ph id="0" equiv="INTERPOLATION" disp="{{ name }}"/></source>
        <target>Ciao, <ph id="0" equiv="INTERPOLATION" disp="{{ name }}"/></target>
      </segment>
    </unit>
    <unit id="itemCount" name="itemCount">
      <segment>
        <source>{VAR_PLURAL, plural, one {<ph id="0" equiv="INTERPOLATION" disp="{{ count }}"/> item} other {<ph id="1" equiv="INTERPOLATION" disp="{{ count }}"/> items}}</source>
        <target>{VAR_PLURAL, plural, one {<ph id="0" equiv="INTERPOLATION" disp="{{ count }}"/> articolo} other {<ph id="1" equiv="INTERPOLATION" disp="{{ count }}"/> articoli}}</target>
      </segment>
    </unit>
    <unit id="localeEn" name="localeEn">
      <segment>
        <source>English</source>
        <target>English</target>
      </segment>
    </unit>
    <unit id="localeIt" name="localeIt">
      <segment>
        <source>Italiano</source>
        <target>Italiano</target>
      </segment>
    </unit>
    <unit id="totalsTotal" name="totalsTotal">
      <segment>
        <source>Total</source>
        <target>Totale</target>
      </segment>
    </unit>
  </file>
</xliff>
