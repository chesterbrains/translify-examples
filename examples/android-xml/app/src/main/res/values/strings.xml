    <string name="app_name">Translify Example</string>
    <string name="greeting">Hello, %1$s</string>
    <string name="positional">%1$s bought %2$d items</string>
    <string name="welcome_markup">Welcome to <b>Translify</b>, it\'s ready</string>
    <string name="discount">Save 20%% today</string>
