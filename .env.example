# Base URL of the translify-be API, including the /api global prefix.
VITE_TRANSLIFY_BASE_URL=http://localhost:3000/api
# Must match the project the API key is bound to.
VITE_TRANSLIFY_PROJECT_SLUG=acme-ecom
# Must be an active environment.
VITE_TRANSLIFY_ENV_SLUG=production
# Raw API key. Never commit a real value.
VITE_TRANSLIFY_API_KEY=
# Comma-separated enabled locale codes.
VITE_TRANSLIFY_LOCALES=en-US,it-IT
